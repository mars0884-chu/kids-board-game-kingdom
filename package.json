{
  "name": "kids-board-game-kingdom",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-content.mjs && node scripts/validate-bopomofo-layout.mjs && node scripts/validate-art-screenshots.mjs && node scripts/validate-gomoku-grid-geometry.mjs && node scripts/validate-gomoku-touch-targets.mjs && node scripts/validate-verification-launcher.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run --pool=forks --maxWorkers=1",
    "verify:jump-chess-webrtc": "node scripts/verify-jump-chess-webrtc-playwright.mjs",
    "verify:jump-chess-online-layout": "node scripts/verify-jump-chess-online-layout-playwright.mjs",
    "verify:game-picker-layout": "node scripts/verify-game-picker-layout-playwright.mjs",
    "test:watch": "vitest",
    "capture:reversi:firefox": "node scripts/capture-reversi-art-proposal-firefox.mjs",
    "capture:dark-chess:edge": "node scripts/capture-dark-chess-art-proposal.mjs",
    "check": "npm run validate && npm run typecheck && npm run test",
    "build": "npm run validate && npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "12.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
